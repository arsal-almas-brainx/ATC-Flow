# Starting admin password. Once it is changed in Settings, this is no longer used.
ADMIN_PASSWORD=change-me
# Signs the login cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Slack bot token (xoxb-…). Optional — a token saved in Settings takes precedence.
SLACK_BOT_TOKEN=

# Public URL of this app (e.g. https://atc-flow-app.fly.dev). Adds a "view full report" link to Slack reports.
APP_URL=

# Days to keep step screenshots (check results and Slack history are kept forever).
SCREENSHOT_RETENTION_DAYS=5

# Google PageSpeed Insights API key. Optional — a key saved in Settings takes precedence.
PAGESPEED_API_KEY=
