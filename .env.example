# Starting admin password. Once it is changed in Settings, this is no longer used.
ADMIN_PASSWORD=change-me
# Signs the login cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Slack bot token (xoxb-…), scopes chat:write and files:write. See README "Slack bot setup".
# Restart the app after changing any value here (README "Editing .env").
SLACK_BOT_TOKEN=

# Public URL of this app (e.g. https://site-checkup.brainxdemo.com). Adds a "view full report" link to Slack reports.
APP_URL=

# Days to keep step screenshots (check results and Slack history are kept forever).
SCREENSHOT_RETENTION_DAYS=5

# Google PageSpeed Insights API key. Without it Google allows only a few speed tests a day.
PAGESPEED_API_KEY=

# Server only (staging) — leave unset locally.
# PORT=3070
# HOST=127.0.0.1
# DATABASE_URL=file:/var/www/atc-flow/data/prod.sqlite
# SCREENSHOT_DIR=/var/www/atc-flow/data/screenshots
