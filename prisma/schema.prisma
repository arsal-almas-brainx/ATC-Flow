// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
// DATABASE_URL is set locally by prisma/.env (file:dev.sqlite) and in
// production by the host, pointing at a persistent volume. Real environment
// variables take precedence over the .env file.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A client store the checker runs against. Replaces the per-shop Shopify
/// install: stores are added by hand in the super admin.
model Store {
  id   String @id @default(cuid())
  name String

  /// Storefront origin, e.g. https://example.com — no path.
  url String

  /// Newline-separated product URLs on this store. The first is the default
  /// for a manual run.
  productUrls  String  @default("")
  discountCode String?

  /// Optional term typed into the store's search. Without it, search uses the
  /// tested product's own title.
  searchQuery String?

  /// Slack channel ID (e.g. C0123ABCD) for this client's reports.
  slackChannel String?

  /// Collection page the speed test measures. Null: /collections/all.
  speedCollectionUrl String?

  /// Storefront (password-protection) password. Replayed through the real
  /// password form by the browser checker before anything else navigates —
  /// this is the shared storefront preview password, not an admin credential.
  storefrontPassword String?

  /// Web Bot Auth signature, created manually in Shopify Admin → Online Store →
  /// Preferences → Crawler access. No API creates or renews these — max
  /// 3-month lifetime — so webBotAuthExpiresAt must be tracked and surfaced,
  /// not assumed. Signature-Agent is not stored: it's always "https://shopify.com".
  webBotAuthSignature      String?
  webBotAuthSignatureInput String?
  webBotAuthExpiresAt      DateTime?

  /// Scheduled checks — see app/atc/schedule.ts. Times are US Eastern.
  scheduleEnabled   Boolean   @default(false)
  /// day | week | month
  schedulePeriod    String    @default("day")
  /// Runs per period, 1–3.
  scheduleFrequency Int       @default(1)
  /// "HH:MM", 24h, Eastern time.
  scheduleTime      String    @default("09:00")
  /// When the scheduler next starts a check. Null while the schedule is off.
  nextRunAt         DateTime?
  lastScheduledAt   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  runs      FlowRun[]
  speedRuns SpeedRun[]
}

/// Global settings — a single row (id 1).
model AppSetting {
  id Int @id @default(1)

  /// Slack channel IDs that receive every store's reports.
  pdcSlackChannel      String?
  deptHeadSlackChannel String?

  /// Slack bot token (xoxb-…). Takes precedence over the SLACK_BOT_TOKEN env
  /// var. Never sent back to the browser.
  slackBotToken String?

  /// Google PageSpeed Insights API key. Takes precedence over the
  /// PAGESPEED_API_KEY env var. Never sent back to the browser.
  pageSpeedApiKey String?

  /// scrypt hash of the admin password, set from Settings. When null the
  /// ADMIN_PASSWORD env var is the password. Never stored in plain text.
  adminPasswordHash      String?
  /// Sessions signed in before this are signed out.
  adminPasswordChangedAt DateTime?

  updatedAt DateTime @updatedAt
}

/// One execution of the add-to-cart → checkout verification flow.
model FlowRun {
  id          String    @id
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productUrl  String
  /// desktop | mobile
  device      String    @default("desktop")
  /// manual | schedule
  trigger     String    @default("manual")
  /// Runs started together by one "Run check" (desktop + mobile) share this.
  groupId     String?
  quantity    Int       @default(1)
  status      String // queued | running | passed | failed | skipped
  startedAt   DateTime
  finishedAt  DateTime?
  error       String?
  cartTotal   String?
  checkoutUrl String?
  /// JSON-encoded RunStep[] — see app/atc/types.ts
  steps       String    @default("[]")
  slackDeliveries SlackDelivery[]

  @@index([storeId, startedAt])
  @@index([groupId])
}

/// Audit trail: every attempt to post a run's report to a Slack channel.
model SlackDelivery {
  id       String   @id @default(cuid())
  /// The flow check's first run (flow reports), or null for speed-only reports.
  runId    String?
  run      FlowRun?  @relation(fields: [runId], references: [id], onDelete: Cascade)
  speedRunId String?
  speedRun   SpeedRun? @relation(fields: [speedRunId], references: [id], onDelete: Cascade)
  /// client | pdc | dept-head
  audience String
  channel  String
  ok       Boolean
  error    String?
  /// Slack message timestamp — identifies the posted message.
  ts       String?
  sentAt   DateTime @default(now())

  @@index([runId])
  @@index([speedRunId])
}

/// One speed test: Google PageSpeed Insights on the homepage, a collection and
/// a product page, each on mobile and desktop.
model SpeedRun {
  id         String    @id
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// manual | schedule
  trigger    String    @default("manual")
  /// running | done
  status     String
  startedAt  DateTime
  finishedAt DateTime?
  /// JSON-encoded SpeedResult[] — see app/atc/speed.server.ts
  results    String    @default("[]")
  slackDeliveries SlackDelivery[]

  @@index([storeId, startedAt])
}
